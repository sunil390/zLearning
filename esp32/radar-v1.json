    {
        "id": "f6fa7c91edf99328",
        "type": "function",
        "z": "26e4e309610a0579",
        "name": "Track Targets (Auto-Recover)",
        "func": "let radarMap = flow.get(\"radarMap\") || {\n    t1: { x: 0, y: 0, active: false, distance: 0, lastUpdate: 0, inZone: false },\n    t2: { x: 0, y: 0, active: false, distance: 0, lastUpdate: 0, inZone: false },\n    t3: { x: 0, y: 0, active: false, distance: 0, lastUpdate: 0, inZone: false },\n    presence: false,\n    anyActive: false\n};\n\nlet topic = msg.topic;\nlet payloadStr = String(msg.payload).toLowerCase().trim();\nconst GEOFENCE_LIMIT = 2000; // 2 meters for Alexa Plug\nconst STICKY_TIMEOUT = 1800000; // 30 min hold\nlet now = Date.now();\nlet updated = false;\nlet isNumeric = (payloadStr !== \"nan\" && payloadStr !== \"unknown\" && payloadStr !== \"\");\n\n// 1. Auto-Recover Presence (If we get coordinates, someone is clearly there)\nif (isNumeric && topic.includes(\"target_\")) {\n    radarMap.presence = true;\n}\n\n// 2. Explicit Presence Handling & Instant Wipe\nif (topic.includes(\"presence\") || topic.includes(\"target_detected\")) {\n    let isPresent = (payloadStr === \"on\" || payloadStr === \"true\");\n    radarMap.presence = isPresent;\n    \n    if (!isPresent) {\n        // Target explicitly left the room: INSTANT WIPE\n        ['t1', 't2', 't3'].forEach(t => {\n            radarMap[t].x = 0; radarMap[t].y = 0; radarMap[t].active = false; \n            radarMap[t].inZone = false; radarMap[t].distance = 0; radarMap[t].lastUpdate = 0;\n        });\n        updated = true;\n    }\n}\n\n// 3. Coordinate Tracking\nif (isNumeric && radarMap.presence) {\n    let val = parseFloat(msg.payload);\n    if (Math.abs(val) > 5) { \n        if (topic.includes(\"target_1\")) {\n            if (topic.endsWith(\"x/state\")) { radarMap.t1.x = val; radarMap.t1.lastUpdate = now; updated = true; }\n            if (topic.endsWith(\"y/state\")) { radarMap.t1.y = val; radarMap.t1.lastUpdate = now; updated = true; }\n        }\n        else if (topic.includes(\"target_2\")) {\n            if (topic.endsWith(\"x/state\")) { radarMap.t2.x = val; radarMap.t2.lastUpdate = now; updated = true; }\n            if (topic.endsWith(\"y/state\")) { radarMap.t2.y = val; radarMap.t2.lastUpdate = now; updated = true; }\n        }\n        else if (topic.includes(\"target_3\")) {\n            if (topic.endsWith(\"x/state\")) { radarMap.t3.x = val; radarMap.t3.lastUpdate = now; updated = true; }\n            if (topic.endsWith(\"y/state\")) { radarMap.t3.y = val; radarMap.t3.lastUpdate = now; updated = true; }\n        }\n    }\n}\n\n// 4. Evaluate Target Timers (Only if someone is in the room)\nif (radarMap.presence) {\n    const evaluateTarget = (t) => {\n        if (t.lastUpdate > 0 && (now - t.lastUpdate > STICKY_TIMEOUT)) {\n            t.x = 0; t.y = 0; t.active = false; t.inZone = false; t.distance = 0; t.lastUpdate = 0; updated = true;\n        } else if (t.lastUpdate > 0) {\n            t.distance = Math.sqrt(Math.pow(t.x, 2) + Math.pow(t.y, 2));\n            t.active = (t.distance > 0);\n            t.inZone = (t.distance > 0 && t.distance <= GEOFENCE_LIMIT);\n        }\n    };\n    evaluateTarget(radarMap.t1);\n    evaluateTarget(radarMap.t2);\n    evaluateTarget(radarMap.t3);\n}\n\n// 5. Check Global Trigger & Route Outputs\nlet lastAnyActive = radarMap.anyActive;\nradarMap.anyActive = (radarMap.t1.inZone || radarMap.t2.inZone || radarMap.t3.inZone);\nflow.set(\"radarMap\", radarMap);\n\nlet msgUI = null;\nlet msgAlexa = null;\n\nif (updated) {\n    msgUI = { payload: radarMap };\n}\n\nif (radarMap.anyActive !== lastAnyActive) {\n    msgAlexa = { payload: radarMap.anyActive ? \"on\" : \"off\" };\n}\n\nreturn [msgUI, msgAlexa];",
